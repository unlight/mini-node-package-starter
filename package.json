{
  "name": "mini-node-package-starter",
  "version": "0.0.0-dev",
  "description": "",
  "keywords": [],
  "license": "MIT",
  "type": "module",
  "files": ["dist"],
  "module": "./dist/mini-node-package-starter.mjs",
  "exports": {
    ".": {
      "import": "./dist/mini-node-package-starter.mjs"
    }
  },
  "scripts": {
    "test": "npm run eslint && npm run test:r",
    "test:r": "node --import tsx --test src/**/*.spec.mts",
    "test:w": "onchange -i -k src -- npm run test:r",
    "test:r2": "glob -c \"node --import tsx --test\" src/**/*.spec.mts",
    "test:w2": "glob -c \"node --import tsx --test --watch\" src/**/*.spec.mts",
    "eslint": "node node_modules/eslint/bin/eslint \"src/**/*.{mts,cts,ts,tsx}\"",
    "eslint:w": "onchange -i -k src -- npm run eslint",
    "eslint:fix": "npm run eslint -- --fix",
    "tscheck": "tsc --noEmit",
    "tscheck:w": "npm run tscheck -- --watch",
    "prebuild": "rm -rf dist",
    "build": "microbundle -i src/index.ts --tsconfig tsconfig.json --no-generateTypes --no-sourcemap --no-compress --target node -f esm -o dist"
  },
  "peerDependencies": {
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.3",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-only-warn": "^1.1.0",
    "eslint-plugin-prettier": "^5.5.4",
    "expect": "^30.2.0",
    "glob": "^13.0.0",
    "globals": "^16.5.0",
    "microbundle": "^0.15.1",
    "onchange": "^7.1.0",
    "prettier": "^3.7.4",
    "reflect-metadata": "^0.2.2",
    "ts-node": "^10.9.2",
    "ts-stubber": "^1.0.19",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1"
  }
}
